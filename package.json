{
  "name": "enhanced-maps-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p packages/maps/tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit -p packages/maps/tsconfig.json && tsc --noEmit -p example/tsconfig.json",
    "test:contracts": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "codegen": "node scripts/codegen.mjs",
    "check:packages": "npm run typecheck && npm run test:contracts && npm run codegen && npm run pack:check",
    "check": "npm run lint && npm run format:check && npm run check:packages",
    "example:bundle": "node scripts/bundle-example.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "npm run start --workspace example --",
    "start:reset": "npm run start -- --reset-cache",
    "example:ios": "node scripts/project.mjs ios",
    "example:android": "node scripts/project.mjs android",
    "example:pods": "node scripts/project.mjs pods",
    "build:ios": "node scripts/project.mjs build:ios",
    "build:android": "node scripts/project.mjs build:android",
    "test": "npm run test:contracts",
    "verify:ios:bridge": "node scripts/check-ios-bridge.mjs",
    "verify:android:bridge": "node scripts/check-android-bridge.mjs",
    "ci": "npm run check && npm run example:bundle",
    "clean": "node scripts/project.mjs clean",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "consumer:prepare": "npm run build && node scripts/prepare-native-consumer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.14",
    "@webgpu/types": "0.1.74",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-webgpu": "0.17.0",
    "react-native-worklets": "0.12.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
