{
  "name": "react-native-enhanced-maps",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./shaders": {
      "types": "./lib/shaders.d.ts",
      "react-native": "./src/shaders.ts",
      "default": "./lib/shaders.js"
    },
    "./app.plugin": "./app.plugin.cjs"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "docs",
    "ios/**/*.{h,m,mm}",
    "android/build.gradle",
    "android/src",
    "*.podspec",
    "react-native.config.cjs",
    "*.rb",
    "cpp",
    "app.plugin.cjs",
    "plugin"
  ],
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "0.85.x",
    "react-native-webgpu": "0.17.x",
    "react-native-worklets": "0.12.2"
  },
  "sideEffects": false,
  "codegenConfig": {
    "name": "EnhancedMapsSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.enhancedmaps"
    },
    "ios": {
      "componentProvider": {
        "EnhancedMapLibreView": "EMMapLibreView",
        "EnhancedMarkerView": "EMMarkerView"
      }
    }
  },
  "peerDependenciesMeta": {
    "react-native-webgpu": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native/normalize-colors": "0.85.3"
  }
}
